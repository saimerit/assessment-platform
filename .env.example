# Public ingress. Caddy obtains TLS certificates for this hostname.
PORTAL_DOMAIN=assessment.example.com
PUBLIC_APP_URL=https://assessment.example.com
CLIENT_RELEASE_URL=https://downloads.example.com/AssessmentLockdownClient.exe

# Managed services: require TLS in production (postgres sslmode=require, rediss, amqps).
ASSESSMENT_DATABASE_URL=postgres://assessment_app:REPLACE_ME@db.example.com:5432/assessment_db?sslmode=require
GRADING_DATABASE_URL=postgres://assessment_grader:REPLACE_ME@db.example.com:5432/assessment_db?sslmode=require
REDIS_URL=rediss://:REPLACE_ME@redis.example.com:6380/0
RABBITMQ_URL=amqps://REPLACE_ME:REPLACE_ME@rabbitmq.example.com/vhost
JWT_SECRET=replace-with-a-rotated-32-character-minimum-secret
ASSESSMENT_APP_DB_PASSWORD=replace-with-a-rotated-password
ASSESSMENT_GRADER_DB_PASSWORD=replace-with-a-rotated-password

# Optional notification delivery.
SMTP_HOST=
SMTP_PORT=
SMTP_SENDER=
